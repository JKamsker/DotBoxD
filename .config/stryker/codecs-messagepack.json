{
  "stryker-config": {
    "project": "DotBoxD.Codecs.MessagePack.csproj",
    "test-projects": [
      "../../../tests/DotBoxD.Services.Tests/DotBoxD.Services.Tests.csproj"
    ],
    "configuration": "Release",
    "mutation-level": "standard",
    "mutate": [
      "MessagePackRpcSerializer.cs",
      "RpcRequestFormatter.cs",
      "RpcResponseFormatter.cs",
      "Formatters/WellFormedStringFormatter.cs"
    ],
    "reporters": ["progress", "html", "json", "markdown"],
    "concurrency": 2,
    "thresholds": { "high": 99, "low": 95, "break": 95 },
    "test-case-filter": "FullyQualifiedName~Protocol|FullyQualifiedName~Tests.Fuzz|FullyQualifiedName~SerializationCoverage|FullyQualifiedName~RpcEnvelope"
  }
}
