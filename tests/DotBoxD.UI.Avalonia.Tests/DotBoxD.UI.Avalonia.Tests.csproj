<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <!-- Explicit timeout/session tokens exercise the renderer lifecycle contract. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../samples/SandboxedUi/Host/Examples.SandboxedUi.Host.csproj" />
    <ProjectReference Include="../../src/UI/DotBoxD.UI.Avalonia/DotBoxD.UI.Avalonia.csproj" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Themes.Simple" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" VersionOverride="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <Using Include="Xunit" />
    <Compile Include="../UI.Conformance/UiRendererConformance.cs" Link="Conformance/UiRendererConformance.cs" />
  </ItemGroup>
</Project>
