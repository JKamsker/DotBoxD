<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <!-- Renderer frames verify browser callbacks and keyed diff behavior. -->
    <NoWarn>$(NoWarn);BL0006;xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/UI/DotBoxD.UI.Blazor/DotBoxD.UI.Blazor.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" VersionOverride="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <Using Include="Xunit" />
    <Compile Include="../UI.Conformance/UiRendererConformance.cs" Link="Conformance/UiRendererConformance.cs" />
  </ItemGroup>
</Project>
